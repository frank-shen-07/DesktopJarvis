{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": { "es2024": true },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",
    "no-undef": "error",
    "no-nested-ternary": "error",
    "no-unneeded-ternary": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],

    "no-await-in-loop": "off",
    "unicorn/consistent-function-scoping": "off",
    "import/no-named-as-default-member": "off",
    "promise/always-return": "off",
    "promise/no-callback-in-promise": "off",
    "oxc/no-map-spread": "off",
    "unicorn/no-array-sort": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    { "files": ["src/**/*.ts", "scripts/**/*.mjs", "vite.config.mts"], "env": { "node": true } },
    {
      "files": ["renderer/**/*.{js,ts,tsx}"],
      "env": { "browser": true },
      "globals": { "theoDragon": "readonly", "theoForge": "readonly", "theoHearing": "readonly" }
    }
  ],
  "ignorePatterns": ["dist/**", "release/**", "voice/**"]
}
